rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Visitors sign in anonymously to read the shared public boost meter.
    // All writes and all claim/cooldown access are server-only (Firebase Admin SDK).
    match /huz_shared/boost_meter {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /boost_claims/{claimId} {
      allow read, write: if false;
    }

    match /claim_cooldowns/{discordUserId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
